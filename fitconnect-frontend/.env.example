# Copy this file to `.env` and adjust if needed.
# Base URL of the FitConnect Spring Boot backend.
# Local run:  http://localhost:8080
# Docker run: http://localhost:8081  (or whatever BACKEND_PORT you set)
VITE_API_BASE_URL=http://localhost:8080

# Google Maps JavaScript API key (for the Community / Coaches map views).
# Get one at https://console.cloud.google.com/ (enable "Maps JavaScript API").
# Without it the map views show a "key missing" notice; the list views still work.
VITE_GOOGLE_MAPS_API_KEY=
