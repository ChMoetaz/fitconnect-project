# Copy this file to ".env" and fill in real values before running `docker compose up`.
# The real .env is git-ignored (see .gitignore) and must never be committed.
# Docker Compose auto-loads .env and substitutes these into docker-compose.yml.

# JWT signing secret (HMAC-SHA256). REQUIRED — the app fails to start without it.
# Must be at least 32 characters / 256 bits. Generate a random one, e.g.:
#   openssl rand -base64 48
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters

# Google Gemini API key, used only by the training-plan generation endpoint.
# Optional to boot the app (register/login work without it), but plan generation
# returns HTTP 400 until it is set. Get one from Google AI Studio.
GEMINI_API_KEY=

# Google Maps Geocoding API key, used to turn a group/coach address into lat/lng
# (GeocodingService) for the map and the /nearby endpoints. Optional: if blank,
# geocoding is simply skipped (creation still succeeds, lat/lng stay null).
# Enable the "Geocoding API" in Google Cloud Console and restrict the key.
GOOGLE_MAPS_API_KEY=
